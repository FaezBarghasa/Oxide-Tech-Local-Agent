{
  "name": "oxide-agent-studio",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "dev:tauri": "vite --port 1420 --strictPort",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:tauri": "vite build",
    "start": "node dist/server.cjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@google/genai": "^2.24.0",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-react": "6.1.1",
    "dotenv": "18.0.4",
    "express": "5.2.1",
    "lucide-react": "1.48.0",
    "motion": "13.4.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "vite": "8.3.1"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@types/express": "5.0.6",
    "autoprefixer": "^10.6.1",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}