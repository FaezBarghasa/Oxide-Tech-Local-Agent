-- migrations/003_multi_tenant.surql
BEGIN;

DEFINE TABLE IF NOT EXISTS tenant SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS name ON TABLE tenant TYPE string;
DEFINE FIELD IF NOT EXISTS slug ON TABLE tenant TYPE string;
DEFINE FIELD IF NOT EXISTS plan ON TABLE tenant TYPE string;
DEFINE FIELD IF NOT EXISTS quotas ON TABLE tenant TYPE object;
DEFINE FIELD IF NOT EXISTS quotas.gpu_hours ON TABLE tenant TYPE int DEFAULT 100;
DEFINE FIELD IF NOT EXISTS quotas.tokens_monthly ON TABLE tenant TYPE int DEFAULT 10000000;

DEFINE TABLE IF NOT EXISTS user SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS email ON TABLE user TYPE string;
DEFINE FIELD IF NOT EXISTS password_hash ON TABLE user TYPE string;
DEFINE FIELD IF NOT EXISTS role ON TABLE user TYPE string;

DEFINE TABLE IF NOT EXISTS membership SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS in ON TABLE membership TYPE record<user>;
DEFINE FIELD IF NOT EXISTS out ON TABLE membership TYPE record<tenant>;
DEFINE FIELD IF NOT EXISTS role ON TABLE membership TYPE string;

DEFINE TABLE IF NOT EXISTS api_key SCHEMAFULL;
DEFINE FIELD IF NOT EXISTS user ON TABLE api_key TYPE record<user>;
DEFINE FIELD IF NOT EXISTS tenant ON TABLE api_key TYPE record<tenant>;
DEFINE FIELD IF NOT EXISTS key_hash ON TABLE api_key TYPE string;
DEFINE FIELD IF NOT EXISTS scopes ON TABLE api_key TYPE array<string>;
DEFINE FIELD IF NOT EXISTS expires_at ON TABLE api_key TYPE option<datetime>;

COMMIT;
